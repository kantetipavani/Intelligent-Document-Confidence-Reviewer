# =============================
# INDCR Environment Variables
# Copy to .env and customize.
# =============================

# Anthropic API key for Claude.
# Get it from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-ank-here

# Anthropic model name used for extraction.
# Examples: claude-3-5-haiku-latest
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# MongoDB connection string.
# Use the compose service name in local dev: mongodb://mongo:27017
MONGODB_URI=mongodb://mongo:27017

# MongoDB database name.
MONGODB_DB=idc_dev

# Secret used to sign JWTs.
# Change this to a strong random value in production.
JWT_SECRET=3253f880ba53ae12529f6dcbfe728f55e94bee9fa8fed4efdcfae5246f3536e0

# When true, backend skips MongoDB persistence.
# Useful for local/dev testing without a database.
SKIP_DB=false

# Next.js frontend uses this to call the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

